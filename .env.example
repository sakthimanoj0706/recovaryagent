# RecoverAI Environment Configuration
# Mode: "demo" (deterministic, 100% offline) or "live" (calls external LLM API)
AI_MODE=demo

# LLM Providers (Optional for Live Mode)
# LLM_PROVIDER=gemini | openrouter
LLM_PROVIDER=openrouter

# API Keys (Required only if AI_MODE=live)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================================
# RecoverAI Step 14: Provider Mode & Razorpay Integration
# ==========================================================

# Provider mode: simulation | razorpay_test | razorpay_live
# Default: simulation (deterministic mock, no external API calls)
RECOVERAI_PROVIDER_MODE=simulation

# Razorpay Test Mode Credentials (TEST keys only — prefix rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Live Mode Hard Block — MUST remain false
RECOVERAI_LIVE_TRANSACTIONS=false

